<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Inference is on-device and there is no network code, so INTERNET is
      deliberately not declared — that makes "no audio leaves the phone"
      verifiable from the manifest alone.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Call Protection: a foreground service (so the microphone session survives
      the app being backgrounded during a call) that draws a floating overlay.
      Each permission is requested from the user explicitly, gated behind its
      own consent screen — see consent/OverlayConsentScreen.kt.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".VoxShieldApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.YugCall">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.YugCall">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".overlay.CallGuardOverlayService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
